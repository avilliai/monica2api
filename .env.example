# Service configuration
API_KEY=change-me
HOST=0.0.0.0
PORT=8000
RELOAD=false
LOG_LEVEL=INFO

# Account pool
COOKIE_FILE=data/cookies.json
COOKIE_STARTUP_PROBE=false
KEEP_ALIVE_MINUTES=30
REFRESH_CONCURRENCY=10
MAX_PROBE_RETRIES=3
PROBE_RETRY_DELAY=1
COOKIE_FAILURE_LIMIT=3

GOOGLE_SPEECH_API_KEY=  #申请google语音识别Google Cloud Speech-to-Text API（语音转文字）的 API Key。
# 账户轮询安全策略：单个账户连续使用次数（防风控）
# 避免同一 IP 短时间内轮番访问所有账户（摊大饼每账号各调 1 次极易被风控封号）
# 设为 > 1（如 5、10、20），单账户连续使用满指定次数后再平滑轮转到下一可用账户
ACCOUNT_CONSECUTIVE_USES=10

# Monica HTTP & Chat Completions proxy
# Registration browser proxy pool (empty value disables; project-relative path)
REGISTER_PROXY_FILE=""  #代理池文件名，可从https://www.webshare.io/?referral_code=dxj0w96er2gb获取代理池
MONICA_WEB_PROTOCOL=true
MONICA_BOT_UID=monica
MONICA_API_BACKEND=httpx
MONICA_CLIENT_VERSION=5.4.3
MONICA_CLIENT_LOCALE=en
MONICA_TIMEZONE=Europe/Moscow
MONICA_TIMEOUT=180
CHAT_MAX_RETRIES=2
CURL_IMPERSONATE=chrome131

# Registration
MONICA_SIGNUP_URL=https://monica.im/sign-up?redirectTo=https%3A%2F%2Fmonica.im%2Fhome
REGISTER_BROWSER_BACKEND=camoufox
REGISTER_CONCURRENCY=1
CAMOUFOX_HEADLESS=true
CAMOUFOX_HUMANIZE=true
CAMOUFOX_LOCALE=en-US
CAMOUFOX_TIMEOUT=120
REGISTER_OUTPUT_FILE=register/monica_accounts.json
REGISTER_ARTIFACT_DIR=register/artifacts

# Email mailbox configuration
# Mode: outlook or worker
EMAIL_MODE=outlook
OUTLOOK_ACCOUNT_FILE=OUT-20260728-S1000-00082_Filtered.txt  #outlook文件名
OUTLOOK_BLACKLIST_FILE=data/outlook_email_blacklist.json
OUTLOOK_TOKEN_URL=https://login.microsoftonline.com/common/oauth2/v2.0/token
OUTLOOK_GRAPH_URL=https://graph.microsoft.com/v1.0
POLL_TIMEOUT=120
POLL_INTERVAL=3

# Temporary Worker mailbox fallback
WORKER_DOMAIN=
EMAIL_DOMAIN=
ADMIN_PASSWORD=

# Daily quota limits
DAILY_QUOTA_LIMIT=40
DAILY_QUOTA_TIMEZONE=Asia/Shanghai

# Context window truncation (主动截断超长上下文保护，避免账号因巨量上下文被风控封号)
# 0 表示不截断；> 0 表示保留的最大 messages 数量（保留 system 提示词，自动成对削减最早的历史消息）
MAX_MESSAGES=0
